# ─────────────────────────────────────────────────────────────
# PhysioCare backend configuration
# Copy this file to  backend/.env  and fill in YOUR OWN values.
# NEVER commit backend/.env — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# Supabase Postgres - Session pooler connection string (Dashboard -> Connect -> Session pooler).
# If the password has special characters, URL-encode them (e.g. @ becomes %40).
DATABASE_URL=
# Supabase project URL and service role key (Dashboard -> Project Settings -> API).
# The service role key bypasses Row Level Security: backend only, never put it in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign login tokens. The server will not start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Server & URLs ────────────────────────────────────────────
PORT=8080
# Frontend URL(s) allowed to call the API (CORS). Comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used for the Google OAuth callback).
BACKEND_URL=http://localhost:8080
# Set to "production" when deployed (e.g. on Render).
NODE_ENV=development

# ── Email OTP via EmailJS (optional locally) ─────────────────
# If left empty in development, the OTP is printed in the backend terminal instead.
# EmailJS dashboard:
#   Email Services      → Service ID
#   Email Templates     → Template ID (template must use {{to_name}}, {{to_email}}, {{otp}};
#                         set the template's "To Email" field to {{to_email}})
#   Account → General   → Public Key and Private Key
#   Account → Security  → enable "Allow EmailJS API for non-browser applications"
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Google login (optional) ──────────────────────────────────
# Leave empty to disable Google login. The server still starts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cyan AI Assistant (optional) ─────────────────────────────
# Leave both keys empty to disable Cyan AI.
# If GEMINI_API_KEY is set, Gemini is used; otherwise ANTHROPIC_API_KEY is used.
#   Gemini key    : https://aistudio.google.com/app/apikey
#   Anthropic key : https://console.anthropic.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Must match the provider that is active, e.g.
#   Gemini    : gemini-flash-lite-latest
#   Anthropic : claude-haiku-4-5-20251001
CHAT_MODEL=
